{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Gmail Cleaner",
  "version": "9.6.0",
  "version_name": "9.6.0 - Erase means erase",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "tabs", "storage", "alarms", "notifications"],
  "host_permissions": ["https://mail.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmailLauncher.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gmail One-Click Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "externally_connectable": {
    "matches": ["https://gmail-cleaner-pro.netlify.app/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
