{
  "env": {
    "browser": true,
    "es2022": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-undef": "error",
    "eqeqeq": [
      "error",
      "always"
    ],
    "no-var": "error",
    "prefer-const": "warn",
    "no-implicit-globals": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "curly": [
      "warn",
      "multi-line"
    ],
    "no-throw-literal": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn"
  },
  "globals": {
    "GCC": "readonly",
    "chrome": "readonly",
    "GCC_CHANGELOG": "readonly"
  },
  "overrides": [
    {
      "files": [
        "changelog-data.js"
      ],
      "env": {
        "commonjs": true
      },
      "rules": {
        "no-var": "off",
        "no-implicit-globals": "off",
        "no-undef": "off"
      }
    },
    {
      "files": [
        "tests/**/*.js",
        "build.js",
        "jest.config.js"
      ],
      "env": {
        "node": true,
        "browser": true,
        "jest": true,
        "commonjs": true
      },
      "globals": {
        "__resetChromeStorage": "readonly",
        "GCC_INTERNALS": "readonly"
      },
      "rules": {
        "no-implicit-globals": "off",
        "eqeqeq": "off",
        "no-new-func": "off",
        "no-template-curly-in-string": "off"
      }
    },
    {
      "files": [
        "netlify/**/*.js",
        "tools/**/*.mjs"
      ],
      "env": {
        "node": true,
        "browser": false,
        "commonjs": true
      },
      "parserOptions": {
        "sourceType": "module"
      },
      "rules": {
        "no-implicit-globals": "off"
      }
    }
  ],
  "ignorePatterns": [
    "browser-polyfill.js",
    "dist/",
    "dist-firefox/",
    "node_modules/",
    "netlify/site/"
  ]
}
